<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the signed/notarized macOS build.
  Kept deliberately minimal — each entry maps to a supported Zergchat feature:
    - network.client / network.server : reach the chat API and run LiveKit huddles.
    - device.audio-input / camera      : huddles (voice + video).
    - cs.allow-jit / cs.allow-unsigned-executable-memory : required by the embedded
      WKWebView's JavaScript engine.
  Deliberately NOT granted:
    - cs.disable-library-validation : the binary statically links its Rust deps and
      loads no third-party dylibs, so library validation stays ON — an attacker can't
      inject an unsigned dylib into the process.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
